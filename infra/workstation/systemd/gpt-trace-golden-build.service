[Unit]
Description=Replayable trusted GPT Trace golden constructor
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/gpt-trace-image-build-complete

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gpt-trace-firstboot
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
