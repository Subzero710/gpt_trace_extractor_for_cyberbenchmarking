[Unit]
Description=Cyber Dataset private execution-host KVM broker
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@REPOSITORY@
ExecStart=/usr/bin/python3 @REPOSITORY@/scripts/distributed.py serve
Restart=on-failure
RestartSec=5
KillMode=process
Delegate=yes
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
