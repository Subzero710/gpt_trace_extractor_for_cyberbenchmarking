[Unit]
Description=Disposable Kali guest agent for GPT Trace
After=display-manager.service
Wants=display-manager.service

[Service]
Type=simple
User=root
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/kali/.Xauthority
EnvironmentFile=/etc/gpt-trace-browser.env
Environment=PYTHONPATH=/opt/gpt-trace/bundle/src
ExecStartPre=/bin/sh -c 'for i in $(seq 1 90); do test -S /tmp/.X11-unix/X0 && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/gpt-trace/venv/bin/python -m kali_workstation.guest.agent
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
