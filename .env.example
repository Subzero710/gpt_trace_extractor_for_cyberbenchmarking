# Deployment-local environment. Secrets stay here; machine/deployment-specific
# values that must not be versioned may also be declared explicitly.
POSTGRES_PASSWORD=change-me
TEACHER_BROWSER_PASSWORD=change-me-too
TEACHER_BROWSER_TUNNEL_TOKEN=
TEACHER_BROWSER_PUBLIC_URL=https://kasm.example.com
CONTROL_PLANE_API_KEY=
APP_KALI_WORKSTATION_TUNNEL_ID=
BENCHMARK_SOURCE_TOKEN=

# control: only DIST_ROLE, DIST_BROKER_URL, Access token pair; optional control address
# execution: only DIST_ROLE and DIST_BROKER_TUNNEL_TOKEN; optional control address
# Set real values from Cloudflare; never commit .env. chmod 600 .env
DIST_ROLE=
DIST_BROKER_URL=
DIST_ACCESS_CLIENT_ID=
DIST_ACCESS_CLIENT_SECRET=
DIST_BROKER_TUNNEL_TOKEN=
# Optional host-isolation extra rule; required for strict acceptance test.
DIST_CONTROL_ADDRESS=
