# Deployment-local environment. Secrets stay here; machine/deployment-specific
# values that must not be versioned may also be declared explicitly.
POSTGRES_PASSWORD=change-me
TEACHER_BROWSER_PASSWORD=change-me-too
TEACHER_BROWSER_TUNNEL_TOKEN=
TEACHER_BROWSER_PUBLIC_URL=https://kasm.example.com
CONTROL_PLANE_API_KEY=
APP_KALI_WORKSTATION_TUNNEL_ID=
BENCHMARK_SOURCE_TOKEN=
APP_CONTROL_TOKEN=

# Control host: Cloudflare-published HTTPS hostname of the execution broker.
# Execution host: token of the dedicated Cloudflare Tunnel.
# No Cloudflare Access service token, IP address, or certificate is needed.
DIST_ROLE=
DIST_BROKER_URL=
DIST_BROKER_TUNNEL_TOKEN=
# Fill these yourself on BOTH machines, with the SAME two independent long secrets.
# Nothing automatically generates or edits these values.
DIST_BROKER_ADMIN_TOKEN=
DIST_BROKER_CONTROLLER_TOKEN=
