POSTGRES_DB=gpt_traces
POSTGRES_USER=gpt_traces
POSTGRES_PASSWORD=change-me
STORAGE_DATABASE_URL=postgresql+psycopg://gpt_traces:change-me@postgres:5432/gpt_traces
STORAGE_BASE_URL=http://storage:8080

# Persistent teacher browser. Generated once by `make init`; keep with browser_profile.
BROWSER_CDP_BASE_URL=http://browser:9222
BROWSER_FINGERPRINT_SEED=
BROWSER_CDP_URL=
BROWSER_NOVNC_PORT=7900
BROWSER_HUMANIZE=true
BROWSER_HUMANIZE_PRESET=default
BROWSER_CLIPBOARD_PORT=8765
BROWSER_CLIPBOARD_URL=http://browser:8765/clipboard
BROWSER_TIMEZONE=
BROWSER_LOCALE=
BROWSER_GEOIP=false
BROWSER_ADOPT_EXISTING_PROFILE=false

# Dedicated benchmark Browser App identity; never share this profile or seed with the teacher browser.
APP_BROWSER_FINGERPRINT_SEED=
APP_BROWSER_PORT=8012
APP_BROWSER_UI_NAME=Browser
APP_BROWSER_MCP_URL=http://app-browser:8000/mcp
APP_BROWSER_ALLOWED_HOSTS=app-browser:8000,localhost:8000,127.0.0.1:8012
APP_BROWSER_SEARCH_URL_TEMPLATE=https://duckduckgo.com/?q={query}
APP_BROWSER_ALLOWED_PRIVATE_HOSTS=
APP_BROWSER_HUMANIZE=true
APP_BROWSER_HUMANIZE_PRESET=default
APP_BROWSER_TIMEZONE=
APP_BROWSER_LOCALE=
APP_BROWSER_GEOIP=false

APP_CODE_WORKSPACE_PORT=8011
APP_CODE_WORKSPACE_UI_NAME=Code Workspace
APP_CODE_WORKSPACE_MCP_URL=http://app-code-workspace:8000/mcp
APP_CODE_WORKSPACE_ALLOWED_HOSTS=app-code-workspace:8000,localhost:8000,127.0.0.1:8011

# External connector identity. Set both before running a task that requests logical App `github`.
APP_GITHUB_UI_NAME=
APP_GITHUB_MANIFEST_PATH=

CLOAKBROWSER_LICENSE_KEY=
CHATGPT_BASE_URL=https://chatgpt.com
CHATGPT_CONVERSATION_TURNS=100
CHATGPT_EXPECTED_MODEL_SLUG=gpt-5-6-thinking
TASKS_ROOT=/data/tasks
CHATGPT_TURN_TIMEOUT_SECONDS=1800
CHATGPT_STREAM_START_TIMEOUT_SECONDS=180
CHATGPT_TOOL_SELECT_TIMEOUT_SECONDS=20
CHATGPT_UPLOAD_TIMEOUT_SECONDS=60
CHATGPT_SITE_READY_TIMEOUT_SECONDS=15
CHATGPT_CHALLENGE_TIMEOUT_SECONDS=180
CHATGPT_NATURAL_SNAPSHOT_WAIT_SECONDS=0
RUNNER_ID=
RUNNER_RECOVER_EXISTING=true
