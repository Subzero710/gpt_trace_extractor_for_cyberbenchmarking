POSTGRES_DB=gpt_traces
POSTGRES_USER=gpt_traces
POSTGRES_PASSWORD=change-me
STORAGE_DATABASE_URL=postgresql+psycopg://gpt_traces:change-me@postgres:5432/gpt_traces
STORAGE_BASE_URL=http://storage:8080
BROWSER_CDP_BASE_URL=http://browser:9222
# Generated once by `make init`; keep stable with the browser_profile volume.
BROWSER_FINGERPRINT_SEED=
BROWSER_CDP_URL=
BROWSER_NOVNC_PORT=7900
BROWSER_HUMANIZE=true
BROWSER_HUMANIZE_PRESET=default
BROWSER_CLIPBOARD_PORT=8765
BROWSER_CLIPBOARD_URL=http://browser:8765/clipboard
# Optional native CloakBrowser identity settings. Leave blank unless deliberately configured.
BROWSER_TIMEZONE=
BROWSER_LOCALE=
BROWSER_GEOIP=false
# One-time migration switch for a browser_profile created before identity markers existed.
BROWSER_ADOPT_EXISTING_PROFILE=false
CLOAKBROWSER_LICENSE_KEY=
CHATGPT_BASE_URL=https://chatgpt.com
CHATGPT_CONVERSATION_TURNS=100
CHATGPT_EXPECTED_MODEL_SLUG=gpt-5-6-thinking
TASKS_ROOT=/data/tasks
CHATGPT_TURN_TIMEOUT_SECONDS=1800
CHATGPT_STREAM_START_TIMEOUT_SECONDS=180
CHATGPT_TOOL_SELECT_TIMEOUT_SECONDS=20
CHATGPT_UPLOAD_TIMEOUT_SECONDS=60
CHATGPT_SITE_READY_TIMEOUT_SECONDS=15
CHATGPT_CHALLENGE_TIMEOUT_SECONDS=180
CHATGPT_NATURAL_SNAPSHOT_WAIT_SECONDS=0
# Optional human-readable label; a unique process nonce is always appended.
RUNNER_ID=
RUNNER_RECOVER_EXISTING=true
