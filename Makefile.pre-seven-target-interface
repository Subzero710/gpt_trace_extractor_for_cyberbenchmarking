.PHONY: init adopt-profile build build-clean build-cache-status up down logs doctor auth run inspect-tools status export test apps-register app-tunnels-doctor app-tunnels-up app-tunnels-logs app-tunnels-down mcp-probe-up mcp-probe-check mcp-probe-state mcp-probe-tunnel-doctor mcp-probe-tunnel mcp-probe-tunnel-logs mcp-probe-tunnel-down mcp-probe-down
init:
	python3 scripts/init_env.py
adopt-profile:
	BROWSER_ADOPT_EXISTING_PROFILE=true docker compose up -d browser
build:
	python3 scripts/build.py
build-clean:
	python3 scripts/build.py --clean
build-cache-status:
	python3 scripts/build.py --status
up:
	docker compose up -d postgres storage browser workspace-gateway browser-gateway
down:
	python3 scripts/down.py
logs:
	docker compose logs -f --tail=200
doctor:
	docker compose run --rm runner doctor
auth:
	docker compose run --rm runner auth
run:
	docker compose run --rm runner run /data/benchmarks/benchmark.jsonl --resume
inspect-tools:
	@test -n "$(TASK_ID)" || (echo "TASK_ID is required" >&2; exit 2)
	docker compose run --rm --no-deps runner inspect-tools /data/benchmarks/benchmark.jsonl --task-id "$(TASK_ID)"
apps-register:
	docker compose run --rm runner register-apps /data/benchmarks/benchmark.jsonl --task-id smoke_isolation_001
app-tunnels-doctor:
	docker compose --profile app-tunnels run --rm mcp-tunnel-workspace doctor --explain
	docker compose --profile app-tunnels run --rm mcp-tunnel-browser doctor --explain
app-tunnels-up:
	docker compose --profile app-tunnels up -d mcp-tunnel-workspace mcp-tunnel-browser
	@docker compose --profile app-tunnels ps mcp-tunnel-workspace mcp-tunnel-browser
app-tunnels-logs:
	docker compose --profile app-tunnels logs -f --tail=100 mcp-tunnel-workspace mcp-tunnel-browser
app-tunnels-down:
	docker compose --profile app-tunnels rm -sf mcp-tunnel-workspace mcp-tunnel-browser
status:
	docker compose run --rm --no-deps runner status
export:
	docker compose run --rm --no-deps runner export /data/exports/dataset.jsonl
test:
	docker compose run --rm --no-deps --entrypoint pytest runner
	docker compose run --rm --no-deps --entrypoint pytest storage
	docker compose --profile runtime-images run --rm --no-deps --entrypoint pytest workspace-runtime-image
	docker compose --profile runtime-images run --rm --no-deps --entrypoint pytest browser-runtime-image
	docker compose run --rm --no-deps --entrypoint pytest workspace-gateway

mcp-probe-up:
	docker compose --profile mcp-probe up -d --build --wait mcp-probe
mcp-probe-check:
	docker compose --profile mcp-probe exec -T mcp-probe mcp-probe-smoke --url http://127.0.0.1:8000/mcp/
mcp-probe-state:
	@curl -fsS "http://127.0.0.1:$${MCP_PROBE_PORT:-8099}/state"; echo
mcp-probe-tunnel-doctor:
	docker compose --profile mcp-probe run --rm mcp-tunnel doctor --explain
mcp-probe-tunnel:
	docker compose --profile mcp-probe up -d mcp-tunnel
	@docker compose --profile mcp-probe ps mcp-tunnel
mcp-probe-tunnel-logs:
	docker compose --profile mcp-probe logs -f --tail=100 mcp-tunnel
mcp-probe-tunnel-down:
	docker compose --profile mcp-probe rm -sf mcp-tunnel
mcp-probe-down:
	docker compose --profile mcp-probe rm -sf mcp-probe
